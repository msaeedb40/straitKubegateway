# syntax=docker/dockerfile:1
# Build stage
FROM golang:1.26-alpine AS builder

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG TARGETARCH
ARG CONTAINERD_VERSION=2.3.4
ARG RUNC_VERSION=1.5.1

WORKDIR /src

RUN apk add --no-cache \
    clang \
    llvm \
    lld \
    bpftool \
    libbpf-dev \
    elfutils-dev \
    linux-headers \
    make \
    gcc \
    musl-dev \
    git

# Cache Go module downloads separately from source
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,id=straitd-gomod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod,id=straitd-gomod \
    --mount=type=cache,target=/root/.cache/go-build,id=straitd-gobuild \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags "-s -w \
      -X github.com/straitkubegateway/straitkubegateway/internal/version.Version=${VERSION} \
      -X github.com/straitkubegateway/straitkubegateway/internal/version.GitCommit=${GIT_COMMIT}" \
    -o /bin/straitd ./cmd/straitd/

# Production stage — minimal runtime with networking tools
FROM alpine:3.24 AS production

ARG VERSION=dev
ARG TARGETARCH
ARG CONTAINERD_VERSION=2.3.4
ARG RUNC_VERSION=1.5.1

RUN apk add --no-cache \
    iproute2 \
    iptables \
    wireguard-tools \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Install containerd 2.3.4 and runc 1.5.1 for CRI compatibility
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
      x86_64)  ARCH=amd64 ;; \
      aarch64) ARCH=arm64 ;; \
    esac; \
    wget -qO- "https://github.com/containerd/containerd/releases/download/v${CONTAINERD_VERSION}/containerd-${CONTAINERD_VERSION}-linux-${ARCH}.tar.gz" \
      | tar -xz -C /usr/local; \
    wget -qO /usr/local/sbin/runc "https://github.com/opencontainers/runc/releases/download/v${RUNC_VERSION}/runc.${ARCH}"; \
    chmod +x /usr/local/sbin/runc; \
    containerd --version; \
    runc --version

COPY --from=builder /bin/straitd /usr/local/bin/straitd

# OCI image labels
LABEL org.opencontainers.image.title="straitd" \
      org.opencontainers.image.description="straitKubegateway node agent — eBPF dataplane, CNI, transit gateway" \
      org.opencontainers.image.source="https://github.com/straitkubegateway/straitkubegateway" \
      org.opencontainers.image.version="${VERSION}"

ENTRYPOINT ["/usr/local/bin/straitd"]
