# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder

WORKDIR /workspace
RUN apk add --no-cache git make clang llvm libelf-dev gcc musl-dev linux-headers

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/straitd ./cmd/straitd
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/cni ./cni/plugin
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/sg-cli ./cmd/sg-cli

FROM alpine:3.20

RUN apk add --no-cache iproute2 iptables wireguard-tools ipsec-tools bash ca-certificates
COPY --from=builder /bin/straitd /usr/local/bin/straitd
COPY --from=builder /bin/cni /usr/local/bin/cni
COPY --from=builder /bin/sg-cli /usr/local/bin/sg-cli

ENTRYPOINT ["/usr/local/bin/straitd"]
