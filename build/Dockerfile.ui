# syntax=docker/dockerfile:1
FROM node:22-alpine AS builder

WORKDIR /app
COPY ui/package*.json ./
RUN npm ci

COPY ui/ ./
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist/ui/browser /usr/share/nginx/html
COPY ui/public/config/runtime-config.json /usr/share/nginx/html/config/runtime-config.json

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
